# ---- Card Investment Model v3 service ---------------------------------------
# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix): the browser talks to this app's
# /api/card-investment/* routes, which forward here. The model URL is never
# shipped to the client and the bundle never leaves the service.
MODEL_API_URL=http://127.0.0.1:8000
MODEL_API_TIMEOUT_MS=25000

