# ---- Card Investment Model service -----------------------------------------
# Server-side ONLY. Never accepted from an API request.
MODEL_BUNDLE_PATH=./model_service/model/card_investment_bundle_v3.joblib
MODEL_METADATA_PATH=./model_service/model/model_metadata_v3.json

# CORS. Comma-separated, exact origins. No wildcard.
# Defaults to localhost only if unset, so a deploy fails closed.
ALLOWED_ORIGINS=http://localhost:3000,https://valhalla-sports.com

PORT=8000
WEB_CONCURRENCY=2          # one bundle per worker; keep low
PREDICT_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
# DOCS_URL=/docs            # leave unset in production
